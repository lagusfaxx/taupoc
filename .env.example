# ─── Base de datos ───────────────────────────────────────────
# En Coolify: apunta al servicio Postgres del mismo proyecto.
DATABASE_URL="postgresql://taupoc:password@db:5432/taupoc?schema=public"

# ─── Seguridad ───────────────────────────────────────────────
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# ─── Sitio ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://taupoc.cl"

# ─── Mercado Pago ────────────────────────────────────────────
# "test" usa credenciales de prueba; "live" cobra de verdad.
MP_MODE="test"
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000"
NEXT_PUBLIC_MP_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Clave secreta de la notificación webhook (Panel MP > Webhooks > Firma secreta).
MP_WEBHOOK_SECRET=""

# ─── Correo transaccional (SMTP) ─────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASSWORD=""
MAIL_FROM="TAUPOC Chile <pedidos@taupoc.cl>"
# Destino de las alertas de stock bajo y pedidos nuevos.
ADMIN_ALERT_EMAIL="ventas@taupoc.cl"

# ─── Archivos ────────────────────────────────────────────────
# Debe apuntar a un volumen persistente en Coolify.
UPLOAD_DIR="/app/public/uploads"

# ─── Datos del admin inicial (solo se usan en el seed) ───────
SEED_ADMIN_EMAIL="admin@taupoc.cl"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
