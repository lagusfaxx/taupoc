# ─── Base de datos ───────────────────────────────────────────
# En Coolify: apunta al servicio Postgres del mismo proyecto.
DATABASE_URL="postgresql://taupoc:password@db:5432/taupoc?schema=public"

# ─── Seguridad ───────────────────────────────────────────────
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# ─── Sitio ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://taupoc.cl"

# ─── Mercado Pago ────────────────────────────────────────────
# "test" usa credenciales de prueba; "live" cobra de verdad.
MP_MODE="test"
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000"
NEXT_PUBLIC_MP_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Clave secreta de la notificación webhook (Panel MP > Webhooks > Firma secreta).
MP_WEBHOOK_SECRET=""

# ─── Correo transaccional ────────────────────────────────────
# Opción 1 (recomendada): API de Resend. Va por HTTPS, así que no depende del
# puerto 587 saliente. La clave se saca de resend.com/api-keys.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Opción 2: SMTP. Se usa solo si no hay RESEND_API_KEY.
# Para Resend por SMTP: host smtp.resend.com, usuario "resend", clave la API key.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# El dominio del remitente debe estar verificado en Resend, o el envío falla.
MAIL_FROM="TAUPOC Chile <pedidos@taupoc.cl>"
# Destino de las alertas de stock bajo, pedidos nuevos y cotizaciones.
ADMIN_ALERT_EMAIL="ventas@taupoc.cl"

# ─── Servidor MCP (Claude) ───────────────────────────────────
# Activa /api/mcp para que Claude administre la tienda. Sin valor, apagado.
# Genera uno con:  openssl rand -hex 32   (mínimo 24 caracteres, sin "$")
MCP_TOKEN=""

# Agente de impresión que corre en el PC con la impresora y saca de la cola
# los packing slips que Claude manda a imprimir. Sin valor, apagado.
# Genera uno con:  openssl rand -hex 32   (distinto de MCP_TOKEN)
PRINT_AGENT_TOKEN=""

# ─── Archivos ────────────────────────────────────────────────
# Debe apuntar a un volumen persistente en Coolify.
UPLOAD_DIR="/app/public/uploads"

# ─── Datos del admin inicial (solo se usan en el seed) ───────
SEED_ADMIN_EMAIL="admin@taupoc.cl"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# ─── Envía (despachos internacionales) ───────────────────────
# Con API key, el checkout ofrece elegir país; Chile sigue usando las tarifas
# del panel. Sin valor, solo se despacha dentro de Chile.
ENVIA_API_KEY=""
# "test" usa api-test.envia.com; "live" genera cotizaciones reales.
ENVIA_MODE="test"
# Opcional: paqueterías a cotizar separadas por coma (ej. "dhl,fedex,ups").
# Sin valor se consultan las disponibles para salir de Chile.
ENVIA_CARRIERS=""
# Dirección de bodega desde donde sale el paquete.
ENVIA_ORIGIN_NAME="TAUPOC Chile"
ENVIA_ORIGIN_PHONE=""
ENVIA_ORIGIN_STREET=""
ENVIA_ORIGIN_NUMBER=""
ENVIA_ORIGIN_DISTRICT=""
ENVIA_ORIGIN_CITY="Santiago"
ENVIA_ORIGIN_STATE="RM"
ENVIA_ORIGIN_POSTAL_CODE=""
# Caja estándar (cm) y peso si el carrito no lo trae (g).
ENVIA_BOX_LENGTH_CM="30"
ENVIA_BOX_WIDTH_CM="25"
ENVIA_BOX_HEIGHT_CM="8"
ENVIA_DEFAULT_WEIGHT_G="500"
# Si Envía cotiza en USD, tipo de cambio para pasarlo a CLP.
ENVIA_USD_TO_CLP=""

# ─── Mapbox (buscador de direcciones internacionales) ────────
# Token público (pk.…) de account.mapbox.com. Se incrusta al compilar:
# en Coolify márcalo como "Build Variable" y vuelve a desplegar.
# Restríngelo por URL a tu dominio. Sin valor, no aparece el buscador.
NEXT_PUBLIC_MAPBOX_TOKEN=""
