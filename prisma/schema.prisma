// TAUPOC Chile — esquema de datos
// Moneda: CLP. Todos los montos son enteros (el peso chileno no usa decimales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Usuarios y cuentas
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  name             String
  lastName         String?
  phone            String?
  rut              String?
  role             Role      @default(CUSTOMER)
  clubName         String?
  acceptsMarketing Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses   Address[]
  orders      Order[]
  resetTokens PasswordResetToken[]
  reviews     Review[]

  @@index([role])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  firstName  String
  lastName   String
  phone      String
  street     String
  number     String
  extra      String?
  commune    String
  city       String
  region     String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Catálogo
// ─────────────────────────────────────────────────────────────

enum ProductKind {
  /// Traje de competición: homologación, tabla de tallas y notas de calce.
  SWIMSUIT
  /// Accesorio: gorros, lentes, toallas. Sin homologación ni calce.
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  COMING_SOON
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

/**
 * Un enlace de la barra de navegación de la tienda.
 * El menú era código: cambiar una categoría del encabezado obligaba a tocar
 * `Header.tsx` y volver a desplegar. Con esto se edita desde el panel. Los
 * enlaces de primer nivel tienen `parentId` nulo; sus hijos son las entradas
 * del desplegable, en el orden de `position`.
 * Sin ninguna fila, la tienda muestra el menú por defecto de `lib/nav.ts`: una
 * instalación nueva —o un menú borrado por error— nunca queda sin navegación.
 */
model MenuItem {
  id       String  @id @default(cuid())
  label    String
  /// Ruta interna ("/catalogo?genero=MALE") o URL completa.
  href     String
  /// Línea de apoyo bajo el enlace, solo en el desplegable.
  note     String?
  position Int     @default(0)
  active   Boolean @default(true)

  parentId String?
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@index([parentId, position])
  @@index([active])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
}

/// Línea técnica (R-SKIN, VEL-SKIN, accesorios...). Editable desde el admin.
model ProductLine {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  description String?
  accentHex   String  @default("#00E0B8")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  /// Escalón dentro de la gama: 1 es la línea de entrada a competición y los
  /// números mayores son líneas superiores. Ordena el comparador y decide qué
  /// línea se marca como la de arriba.
  tier      Int     @default(1)
  /// Nombre del escalón en la tienda, ej. "Serie Élite". Es el distintivo que
  /// separa una línea cara de una barata antes de abrir la ficha.
  tierLabel String?
  /// Para quién es la línea. La frase que resuelve "¿cuál de las dos compro?".
  bestFor   String?
  /// Los dos o tres datos que separan esta línea de la otra, para la tarjeta
  /// del catálogo. Con la misma foto en las dos líneas, es lo único que
  /// distingue una tarjeta de la otra antes de entrar a la ficha.
  cardClaim String?

  products  Product[]
  sizeChart SizeChartRow[]
  metrics   LineMetric[]
}

/**
 * Una fila del comparador entre líneas.
 * Las dos líneas repiten las mismas etiquetas para que el comparador las
 * enfrente fila por fila. `score` es solo el largo de la barra; el dato que
 * se lee es `value`.
 */
model LineMetric {
  id        String      @id @default(cuid())
  lineId    String
  line      ProductLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  label     String
  value     String
  /// 0 a 100. No es un porcentaje del dato, es cuánto se llena la barra.
  score     Int         @default(0)
  /// Nota al pie de la fila, para matizar un dato que no es "más es mejor".
  note      String?
  sortOrder Int         @default(0)

  @@unique([lineId, label])
  @@index([lineId])
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  /// Código de modelo del fabricante, ej. TS703
  modelCode   String        @unique
  subtitle    String?
  description String        @default("")
  status      ProductStatus @default(DRAFT)
  gender      Gender        @default(UNISEX)
  /// Qué es el producto. Un gorro o unos lentes no tienen homologación ni
  /// calce, y pedirlos en el panel obliga a inventar datos que después
  /// ensucian la ficha.
  kind        ProductKind   @default(SWIMSUIT)

  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lineId     String?
  line       ProductLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)

  /// Homologación World Aquatics — el argumento de venta principal.
  approvalCode      String?
  approvalBody      String  @default("World Aquatics")
  approvalYear      Int?
  approvalVerifyUrl String?

  basePrice   Int
  /// Peso unitario en gramos, para el cálculo de envío.
  weightGrams Int @default(180)

  // Ficha técnica
  composition   String?
  construction  String?
  finish        String?
  countryOrigin String?
  careNotes     String?
  /// Notas de calce. Los trajes de competencia se usan 1-2 tallas por debajo.
  fitNotes      String?
  fitOffset     Int     @default(1)

  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colors     ProductColor[]
  variants   Variant[]
  images     ProductImage[]
  sizeChart  SizeChartRow[]
  specs      ProductSpec[]
  orderItems OrderItem[]
  coupons    CouponProduct[]
  homeItems  HomeBlockItem[]
  reviews    Review[]

  @@index([status])
  @@index([gender])
  @@index([lineId])
  @@index([featured])
}

/// Calificación de un producto.
///
/// Se cargan a mano desde el panel: son reseñas que los clientes dejaron por
/// WhatsApp, Instagram o en el stand del torneo, y que acá quedan atribuidas
/// al producto para que se vean en la ficha y las lea Google.
model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Cliente registrado, cuando la reseña vino de una cuenta del sitio.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// De 1 a 5. Se valida en la acción, Postgres no tiene rango nativo.
  rating     Int
  title      String?
  body       String  @default("")
  authorName String
  /// Club, ciudad o categoría. Da contexto sin exponer al cliente.
  authorNote String?

  /// Compra verificada. Solo lo marca el panel, y solo si consta el pedido.
  verified Boolean      @default(false)
  status   ReviewStatus @default(PUBLISHED)

  /// Fecha que se muestra y que viaja en el marcado de Google. Se separa de
  /// `createdAt` para que una reseña antigua cargada hoy no aparezca de hoy.
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([publishedAt])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductColor {
  id           String  @id @default(cuid())
  productId    String
  name         String
  slug         String
  /// Código de colorway del fabricante, ej. 9192.
  code         String?
  hex          String  @default("#111111")
  hexSecondary String?
  /// Acento de interfaz cuando este color está seleccionado.
  accentHex    String  @default("#00E0B8")
  /// Color del vivo o ribete, ej. 1360. Es parte de la especificación del traje.
  stripCode    String?
  stripHex     String?
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants Variant[]
  images   ProductImage[]

  @@unique([productId, slug])
  @@index([productId])
}

model Variant {
  id                String  @id @default(cuid())
  productId         String
  colorId           String
  /// Talla numérica de competición: 20 a 36.
  size              String
  sku               String  @unique
  stock             Int     @default(0)
  /// Stock reservado por pedidos pendientes de pago.
  reserved          Int     @default(0)
  priceOverride     Int?
  lowStockThreshold Int     @default(1)
  barcode           String?
  active            Boolean @default(true)
  sortOrder         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      ProductColor        @relation(fields: [colorId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]
  cartEvents CartEvent[]
  interests  SizeInterest[]

  @@unique([productId, colorId, size])
  @@index([productId])
  @@index([colorId])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  colorId   String?
  url       String
  alt       String  @default("")
  width     Int     @default(0)
  height    Int     @default(0)
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([colorId])
}

/// Tabla de tallas. Se define por línea (heredada) o se sobrescribe por producto.
model SizeChartRow {
  id          String  @id @default(cuid())
  lineId      String?
  productId   String?
  size        String
  /// Medidas del cuerpo en centímetros.
  chestMinCm  Int?
  chestMaxCm  Int?
  waistMinCm  Int?
  waistMaxCm  Int?
  hipMinCm    Int?
  hipMaxCm    Int?
  heightMinCm Int?
  heightMaxCm Int?
  // Equivalencias internacionales
  cn          String?
  usa         String?
  uk          String?
  aus         String?
  nz          String?
  sortOrder   Int     @default(0)

  line    ProductLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([productId])
}

enum MovementType {
  ADJUST
  SALE
  RETURN
  RESTOCK
  CANCEL
}

model InventoryMovement {
  id         String       @id @default(cuid())
  variantId  String
  type       MovementType
  delta      Int
  resulting  Int
  reason     String?
  actorEmail String?
  orderId    String?
  createdAt  DateTime     @default(now())
  variant    Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Carrito
// ─────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  token      String     @unique
  userId     String?
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

/// Cada vez que una talla entra al carrito. Los ítems del carrito se borran o
/// cambian; este registro queda para medir qué se agrega y no se compra.
model CartEvent {
  id        String   @id @default(cuid())
  variantId String
  cartId    String
  quantity  Int
  createdAt DateTime @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
}

/// "¿Te interesa esta talla?" sobre una talla agotada o apagada.
model SizeInterest {
  id         String    @id @default(cuid())
  variantId  String
  /// Carrito o visitante que lo pidió, para no contar dos veces el mismo clic.
  visitorKey String
  email      String?
  userId     String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, visitorKey])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Envíos
// ─────────────────────────────────────────────────────────────

enum RateMode {
  FLAT
  BY_WEIGHT
  BY_SUBTOTAL
}

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  /// Códigos de región de Chile cubiertos por la zona (ver src/lib/chile.ts).
  regions   String[]
  sortOrder Int            @default(0)
  active    Boolean        @default(true)
  rates     ShippingRate[]
}

model ShippingRate {
  id          String   @id @default(cuid())
  zoneId      String
  carrier     String   @default("Chilexpress")
  label       String
  description String?
  mode        RateMode @default(FLAT)
  price       Int      @default(0)

  /// Rango de peso en gramos (modo BY_WEIGHT).
  minWeightG       Int?
  maxWeightG       Int?
  /// Rango de subtotal en CLP (modo BY_SUBTOTAL).
  minSubtotal      Int?
  maxSubtotal      Int?
  /// Envío gratis cuando el subtotal supera este monto.
  freeOverSubtotal Int?

  etaMinDays Int     @default(2)
  etaMaxDays Int     @default(5)
  /// Retiro en tienda o entrega en torneo: no requiere dirección de despacho.
  isPickup   Boolean @default(false)
  pickupInfo String?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

// ─────────────────────────────────────────────────────────────
// Cupones
// ─────────────────────────────────────────────────────────────

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  description  String?
  type         CouponType @default(PERCENT)
  /// Porcentaje (1-100) o monto fijo en CLP según el tipo.
  value        Int        @default(0)
  minSubtotal  Int?
  maxUses      Int?
  usedCount    Int        @default(0)
  perUserLimit Int?
  startsAt     DateTime?
  endsAt       DateTime?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  products CouponProduct[]
  orders   Order[]
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

// ─────────────────────────────────────────────────────────────
// Pedidos
// ─────────────────────────────────────────────────────────────

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  REFUNDED
  CHARGED_BACK
  CANCELLED
}

/// Cómo paga el cliente. Mercado Pago se confirma solo por webhook; la
/// transferencia la confirma el equipo desde el panel al ver el abono.
enum PaymentMethod {
  MANUAL
  MERCADOPAGO
  TRANSFER
  PAYPAL
}

model Order {
  id     String  @id @default(cuid())
  /// Número visible al cliente, ej. TP-1042
  number String  @unique
  userId String?
  email  String
  phone  String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(MERCADOPAGO)

  subtotal        Int    @default(0)
  /// Todos los descuentos: cupón más el del medio de pago.
  discountTotal   Int    @default(0)
  /// La parte de `discountTotal` que viene del medio de pago elegido.
  paymentDiscount Int    @default(0)
  shippingTotal   Int    @default(0)
  total           Int    @default(0)
  currency        String @default("CLP")

  couponId   String?
  couponCode String?

  // Snapshot de despacho
  shippingRateId  String?
  shippingLabel   String?
  shippingCarrier String?
  isPickup        Boolean @default(false)
  /// ISO 3166-1 alfa-2. Fuera de Chile, `region` guarda el estado y `commune` la ciudad.
  country         String  @default("CL")
  firstName       String?
  lastName        String?
  street          String?
  streetNumber    String?
  addressExtra    String?
  commune         String?
  city            String?
  region          String?
  postalCode      String?
  customerNote    String?

  // Seguimiento
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  paidAt         DateTime?

  // Mercado Pago
  mpPreferenceId String?
  mpPaymentId    String?
  mpStatusDetail String?
  mpPaymentType  String?
  mpInstallments Int?

  // PayPal (pedidos internacionales, cobrados en USD)
  paypalOrderId    String?
  paypalCaptureId  String?
  /// Lo que efectivamente se cobró, si no fue en CLP. Monto en centavos.
  chargedCurrency  String?
  chargedCents     Int?

  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  OrderItem[]
  events OrderEvent[]
  creationKey String? @unique
  stockCommitted Boolean @default(false)
  // Unidades apartadas en Variant.reserved mientras el cliente paga. Al
  // confirmarse el pago pasan a descontarse del stock; si vence el plazo,
  // vuelven a quedar disponibles.
  stockReserved Boolean   @default(false)
  reservedUntil DateTime?
  // Tienda donde se compró: "CL" (taupoc.cl) o "INTL" (taupoc.lat). En las
  // de taupoc.lat los montos del pedido son el equivalente en pesos de lo
  // cobrado en dólares (chargedCents).
  storefront       String    @default("CL")
  buyerTaxId       String?
  dutiesAcceptedAt DateTime?

  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([email])
  @@index([mpPaymentId])
  @@index([paypalOrderId])
  @@index([stockReserved, reservedUntil])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?
  productId String?

  // Snapshot: el pedido no debe cambiar si el catálogo cambia.
  productName String
  colorName   String
  size        String
  sku         String
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  actor     String?
  payload   Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Contenido y captación
// ─────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String     @default("")
  body           String     @default("")
  coverUrl       String?
  tags           String[]
  author         String     @default("Equipo TAUPOC Chile")
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model QuoteRequest {
  id          String      @id @default(cuid())
  clubName    String
  contactName String
  email       String
  phone       String
  region      String?
  athletes    Int?
  interest    String?
  message     String      @default("")
  status      QuoteStatus @default(NEW)
  adminNote   String?
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

/// Configuración editable desde el panel: analytics, correos, umbrales, textos.
/**
 * Cómo se redondea el precio en dólares de taupoc.lat a un valor comercial.
 * Siempre hacia arriba: nunca se cobra menos que lo calculado.
 */
enum PriceRounding {
  CENTS_99 // 138,99
  WHOLE // 139
  WHOLE_9 // 139, 149, 199: el entero terminado en 9
  WHOLE_5 // 135, 145: el entero terminado en 5
}

/**
 * Tipo de cambio de la tienda internacional. Cada cambio es una fila nueva:
 * la vigente es la última con effectiveFrom ya cumplido, y el historial queda
 * para saber con qué valores se cobró cada pedido.
 *
 * El precio en dólares se calcula desde el precio chileno: se le quita el IVA
 * (la venta al extranjero es exportación, exenta), se divide por el tipo de
 * cambio, se suma el margen y se redondea.
 */
model ExchangeRate {
  id            String        @id @default(cuid())
  clpPerUsd     Decimal       @db.Decimal(10, 2)
  marginPct     Decimal       @db.Decimal(5, 2)
  vatPct        Decimal       @default(19) @db.Decimal(5, 2)
  rounding      PriceRounding @default(WHOLE_9)
  effectiveFrom DateTime      @default(now())
  createdBy     String?
  note          String?
  createdAt     DateTime      @default(now())

  @@index([effectiveFrom])
}

enum IntlBannerAlign {
  LEFT
  CENTER
}

enum IntlBannerVertical {
  TOP
  CENTER
  BOTTOM
}

enum IntlBannerTone {
  DARK // texto grafito, para fotos claras
  LIGHT // texto blanco, para fotos oscuras
}

enum IntlBannerHeight {
  FULL // toda la pantalla
  LARGE
  MEDIUM
}

/**
 * Banners de la portada de taupoc.lat, editables desde el panel. Con más de
 * uno activo la portada los muestra como carrusel, en el orden de position.
 * Tabla propia: la portada de taupoc.cl sigue con sus bloques (HomeBlock).
 */
model IntlBanner {
  id             String             @id @default(cuid())
  position       Int                @default(0)
  active         Boolean            @default(true)
  imageUrl       String
  /** Imagen para teléfono. Vacía: se usa la de escritorio recortada. */
  imageMobileUrl String?
  alt            String             @default("")
  /** Punto de la foto que nunca se recorta, en porcentaje (0–100). */
  focalX         Int                @default(50)
  focalY         Int                @default(50)
  eyebrow        String?
  title          String             @default("")
  body           String?
  ctaLabel       String?
  ctaHref        String?
  align          IntlBannerAlign    @default(LEFT)
  vertical       IntlBannerVertical @default(BOTTOM)
  tone           IntlBannerTone     @default(DARK)
  /** Velo liso sobre la foto para leer el texto, 0–60 %. Sin degradados. */
  overlay        Int                @default(0)
  height         IntlBannerHeight   @default(LARGE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([active, position])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Contador para generar números de pedido correlativos.
model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────────────────────────────────────────
// Medios e inicio editable
// ─────────────────────────────────────────────────────────────

/// Archivo subido desde el panel.
///
/// Se guarda en Postgres y no en disco porque el contenedor se reemplaza en
/// cada despliegue: cualquier archivo escrito en el sistema de archivos se
/// pierde salvo que haya un volumen montado. En la base entra además en el
/// respaldo de la tienda sin configurar nada aparte.
model MediaAsset {
  id       String @id @default(cuid())
  filename String
  mimeType String
  size     Int
  bytes    Bytes
  alt      String @default("")

  createdAt DateTime @default(now())

  variants MediaVariant[]
}

/// Copia de una imagen en un ancho y formato concretos.
///
/// Es caché: el original nunca se toca y si falta se sirve tal cual se subió.
model MediaVariant {
  id      String     @id @default(cuid())
  mediaId String
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  /// 0 significa "el ancho original".
  width  Int
  /// avif, webp u "origen" cuando solo cambia el ancho.
  format String

  mimeType String
  size     Int
  bytes    Bytes

  createdAt DateTime @default(now())

  @@unique([mediaId, width, format])
}

enum HomeBlockType {
  BANNER
  PRODUCTOS
  CATEGORIAS
  MEDIA
  TEXTO
}

enum BlockHeight {
  AUTO
  COMPACTA
  MEDIA
  ALTA
  PANTALLA
}

enum BlockAlign {
  IZQUIERDA
  CENTRO
  DERECHA
}

/// Una sección del inicio. El orden lo decide `position`.
model HomeBlock {
  id       String        @id @default(cuid())
  type     HomeBlockType
  position Int           @default(0)
  active   Boolean       @default(true)

  /// Nombre interno para reconocer el bloque en el panel.
  label String @default("")

  eyebrow  String?
  title    String?
  subtitle String?
  body     String?

  ctaLabel    String?
  ctaHref     String?
  ctaAltLabel String?
  ctaAltHref  String?

  /// URL de la imagen o el video: una subida (/api/media/…) o una externa.
  imageUrl       String?
  /// Versión para pantallas angostas; si falta se usa la principal.
  imageMobileUrl String?
  videoUrl       String?
  posterUrl      String?

  /// contain deja ver la imagen completa; cover la recorta para llenar.
  fit        String      @default("cover")
  /// Oscurecido sobre el medio, de 0 a 90, para que el texto se lea.
  overlay    Int         @default(40)
  height     BlockHeight @default(MEDIA)
  align      BlockAlign  @default(IZQUIERDA)
  /// Fondo del bloque cuando no lleva imagen.
  background String      @default("ink")

  /// Cuántas columnas usa una grilla de productos o de mosaico.
  columns Int @default(4)

  /// Segundos que dura cada lámina de un banner con varias.
  intervalSec Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items HomeBlockItem[]

  @@index([active, position])
}

/// Elemento de un bloque: un producto elegido a mano o una tarjeta suelta.
model HomeBlockItem {
  id      String    @id @default(cuid())
  blockId String
  block   HomeBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  position       Int     @default(0)
  eyebrow        String?
  label          String?
  caption        String?
  ctaLabel       String?
  href           String?
  imageUrl       String?
  /// Versión para pantallas angostas; si falta se usa la principal.
  imageMobileUrl String?
  videoUrl       String?
  posterUrl      String?

  @@index([blockId, position])
}

// ─────────────────────────────────────────────────────────────
// Servidor MCP
// ─────────────────────────────────────────────────────────────

/// Una llamada a una herramienta del servidor MCP (`/api/mcp`).
///
/// Las herramientas que cambian datos se aplican al instante; esta bitácora
/// es lo que permite saber después qué hizo el asistente y con qué datos.
model McpLog {
  id         String   @id @default(cuid())
  tool       String
  args       Json?
  ok         Boolean  @default(true)
  /// Resumen del resultado o el error, recortado.
  result     String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tool])
}

// ─────────────────────────────────────────────────────────────
// Cola de impresión
// ─────────────────────────────────────────────────────────────

enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
  CANCELLED
}

/// Documento esperando al agente de impresión que corre en el PC de la
/// tienda. Claude lo encola por MCP; el agente lo descarga, lo manda a la
/// impresora y avisa cómo le fue.
model PrintJob {
  id        String         @id @default(cuid())
  /// "packing_slip" por ahora.
  kind      String
  title     String
  /// Lo que contiene el PDF (números de pedido).
  refs      String[]
  copies    Int            @default(1)
  pdf       Bytes
  status    PrintJobStatus @default(PENDING)
  attempts  Int            @default(0)
  error     String?
  createdAt DateTime       @default(now())
  /// Última vez que el agente lo descargó; si no avisa en 10 minutos vuelve a la cola.
  claimedAt DateTime?
  printedAt DateTime?

  @@index([status, createdAt])
  @@index([kind])
}
